# Copy this file to .env and fill in your details.

# Base URL of your Nginx Proxy Manager admin UI (the port-81 one).
NPM_BASE_URL=http://192.168.1.10:81

# Credentials for an NPM user. A dedicated read-only-ish account is a good
# idea if NPM ever adds proper roles; for now any user with API access works.
NPM_EMAIL=dashboard@yourdomain.com
NPM_PASSWORD=change-me

# Leave this line commented out / unset: the app auto-falls-back to demo
# data whenever NPM_EMAIL or NPM_PASSWORD is blank. Set DEMO_MODE=true to
# force demo data even with credentials filled in, or DEMO_MODE=false to
# force live mode (will show an error banner if credentials are missing).
# DEMO_MODE=

# How often (seconds) this dashboard TCP-checks each route's backend.
HEALTH_CHECK_INTERVAL_SECONDS=30

# How often (seconds) this dashboard re-pulls the host list from NPM's API.
NPM_POLL_INTERVAL_SECONDS=60

# Name shown as the hub in the diagram / page title.
DASHBOARD_NAME=home-proxy

PORT=5080
